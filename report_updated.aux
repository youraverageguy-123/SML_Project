\@writefile{toc}{\contentsline {subsection}{\numberline {6.7}Data Efficiency (Learning Curves)}{11}{subsection.6.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Cross-validated (3-fold) learning curves for Logistic Regression. DistilBERT achieves high accuracy with far fewer training samples than BoW. The BoW curve continues to improve throughout the range while DistilBERT saturates early, confirming that contextual embeddings are substantially more data-efficient.}}{11}{figure.caption.12}\protected@file@percent }
\newlabel{fig:lc}{{11}{11}{Cross-validated (3-fold) learning curves for Logistic Regression. DistilBERT achieves high accuracy with far fewer training samples than BoW. The BoW curve continues to improve throughout the range while DistilBERT saturates early, confirming that contextual embeddings are substantially more data-efficient}{figure.caption.12}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.8}Accuracy--Efficiency Trade-off}{11}{subsection.6.8}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Accuracy vs training time (log scale) for all model--feature combinations. Colour encodes feature family; marker shape encodes model. Lower-right configurations are accurate but slow; upper-left are fast but less accurate. Logistic Regression on Reduced DistilBERT (PCA) sits on the efficiency frontier.}}{12}{figure.caption.13}\protected@file@percent }
\newlabel{fig:scatter}{{12}{12}{Accuracy vs training time (log scale) for all model--feature combinations. Colour encodes feature family; marker shape encodes model. Lower-right configurations are accurate but slow; upper-left are fast but less accurate. Logistic Regression on Reduced DistilBERT (PCA) sits on the efficiency frontier}{figure.caption.13}{}}
