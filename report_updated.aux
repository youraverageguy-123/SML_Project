\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:eda}{{1}{2}{EDA overview: class distribution (left), token length histogram with mean annotated (centre), and top-15 filtered unigrams after stop-word removal (right). Generic newswire markers (\textit {said}, \textit {reuters}) have been filtered out so that content-bearing terms are visible}{figure.caption.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Discriminative vocabulary per class extracted from Logistic Regression coefficients on Bag-of-Words features. Word size is proportional to the LR coefficient --- these words push the model toward each class, not merely frequent words. Sports vocabulary is highly domain-specific; Business and Sci/Tech share technological vocabulary, foreshadowing their confusion in classification.}}{2}{figure.caption.2}\protected@file@percent }
\newlabel{fig:wordclouds}{{2}{2}{Discriminative vocabulary per class extracted from Logistic Regression coefficients on Bag-of-Words features. Word size is proportional to the LR coefficient --- these words push the model toward each class, not merely frequent words. Sports vocabulary is highly domain-specific; Business and Sci/Tech share technological vocabulary, foreshadowing their confusion in classification}{figure.caption.2}{}}
\@writefile{toc}{\contentsline {section}{\numberline {3}Methodology}{2}{section.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.1}Part A: Sparse Features}{2}{subsection.3.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}Part B: Static Dense Embeddings (GloVe, Bonus)}{3}{subsection.3.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}Part C: Contextual Embeddings (DistilBERT)}{3}{subsection.3.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.4}Part D: Models}{3}{subsection.3.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.5}Part E: Dimensionality Reduction}{3}{subsection.3.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Cumulative explained variance as a function of the number of retained components. The red dotted line marks $n=100$, our chosen dimensionality. PCA on DistilBERT retains 85.89\% of variance at this cutoff because the embedding space has strong structure. Truncated SVD on TF-IDF retains only 17.13\% --- sparse representations are nearly isotropic and compression is inherently destructive.}}{4}{figure.caption.3}\protected@file@percent }
\newlabel{fig:scree}{{3}{4}{Cumulative explained variance as a function of the number of retained components. The red dotted line marks $n=100$, our chosen dimensionality. PCA on DistilBERT retains 85.89\% of variance at this cutoff because the embedding space has strong structure. Truncated SVD on TF-IDF retains only 17.13\% --- sparse representations are nearly isotropic and compression is inherently destructive}{figure.caption.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.6}Part F: Feature Space Geometry}{4}{subsection.3.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Cosine similarity between class centroids for each feature space. Lower off-diagonal values indicate better geometric separation of classes. DistilBERT centroids show the lowest average off-diagonal similarity, confirming that the accuracy gap is a property of feature geometry rather than the classifier.}}{4}{figure.caption.4}\protected@file@percent }
\newlabel{fig:centroid}{{4}{4}{Cosine similarity between class centroids for each feature space. Lower off-diagonal values indicate better geometric separation of classes. DistilBERT centroids show the lowest average off-diagonal similarity, confirming that the accuracy gap is a property of feature geometry rather than the classifier}{figure.caption.4}{}}
