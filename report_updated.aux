\@writefile{toc}{\contentsline {subsection}{\numberline {5.1}Accuracy Comparison}{5}{subsection.5.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Grouped bar chart comparing accuracy of Logistic Regression, Linear SVM, RBF SVM, and KNN across all feature spaces. The three-tier progression Sparse $\to $ GloVe $\to $ DistilBERT is visible across all models.}}{5}{figure.caption.5}\protected@file@percent }
\newlabel{fig:accuracy}{{5}{5}{Grouped bar chart comparing accuracy of Logistic Regression, Linear SVM, RBF SVM, and KNN across all feature spaces. The three-tier progression Sparse $\to $ GloVe $\to $ DistilBERT is visible across all models}{figure.caption.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}Per-Class F1-Score Analysis}{5}{subsection.5.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Per-class F1-score heatmap for all supervised models. Left: Bag-of-Words features. Right: Reduced DistilBERT (PCA). Sports achieves near-perfect F1 ($>0.97$) with DistilBERT. The Business--Sci/Tech confusion persists across all configurations, consistent with their overlapping lexicons in modern tech-company journalism.}}{6}{figure.caption.6}\protected@file@percent }
\newlabel{fig:heatmap}{{6}{6}{Per-class F1-score heatmap for all supervised models. Left: Bag-of-Words features. Right: Reduced DistilBERT (PCA). Sports achieves near-perfect F1 ($>0.97$) with DistilBERT. The Business--Sci/Tech confusion persists across all configurations, consistent with their overlapping lexicons in modern tech-company journalism}{figure.caption.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}Numerical Results}{6}{subsection.5.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Accuracy and Macro F1-score for all model--feature combinations. Best accuracy per model shown in \textbf  {bold}.}}{7}{table.caption.7}\protected@file@percent }
\newlabel{tab:results}{{1}{7}{Accuracy and Macro F1-score for all model--feature combinations. Best accuracy per model shown in \textbf {bold}}{table.caption.7}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.4}Feature Space Geometry}{7}{subsection.5.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces PCA 2D projections. Left: DistilBERT (Sports separates cleanly; Business and Sci/Tech overlap, foreshadowing their confusion). Right: GloVe (partial separation; less structured than DistilBERT but more than BoW).}}{8}{figure.caption.8}\protected@file@percent }
\newlabel{fig:pca}{{7}{8}{PCA 2D projections. Left: DistilBERT (Sports separates cleanly; Business and Sci/Tech overlap, foreshadowing their confusion). Right: GloVe (partial separation; less structured than DistilBERT but more than BoW)}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces t-SNE visualisation (1,000 samples). Bag-of-Words (left) produces an indistinguishable blob. GloVe (centre) shows partial cluster emergence. DistilBERT (right) forms tight, well-separated clusters even before any classifier is applied. This three-panel comparison makes the core argument of this project visually self-evident.}}{8}{figure.caption.9}\protected@file@percent }
\newlabel{fig:tsne}{{8}{8}{t-SNE visualisation (1,000 samples). Bag-of-Words (left) produces an indistinguishable blob. GloVe (centre) shows partial cluster emergence. DistilBERT (right) forms tight, well-separated clusters even before any classifier is applied. This three-panel comparison makes the core argument of this project visually self-evident}{figure.caption.9}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.5}Confusion Matrix}{8}{subsection.5.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Confusion matrix for RBF SVM on Reduced DistilBERT (PCA) --- the best-performing configuration across all experiments (90.19\% accuracy). Sports is classified near-perfectly (402/408). The primary source of error is Business articles misclassified as Sci/Tech (49 cases), which is semantically expected --- modern tech-company news straddles both domains.}}{9}{figure.caption.10}\protected@file@percent }
\newlabel{fig:cm}{{9}{9}{Confusion matrix for RBF SVM on Reduced DistilBERT (PCA) --- the best-performing configuration across all experiments (90.19\% accuracy). Sports is classified near-perfectly (402/408). The primary source of error is Business articles misclassified as Sci/Tech (49 cases), which is semantically expected --- modern tech-company news straddles both domains}{figure.caption.10}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.6}KMeans Unsupervised Quality}{9}{subsection.5.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces KMeans cluster quality (NMI and ARI) across all feature spaces. Higher values indicate that the natural cluster geometry aligns better with ground-truth labels. DistilBERT substantially outperforms sparse features on both metrics, confirming that its class structure is learnable even without a classifier.}}{9}{figure.caption.11}\protected@file@percent }
\newlabel{fig:kmeans}{{10}{9}{KMeans cluster quality (NMI and ARI) across all feature spaces. Higher values indicate that the natural cluster geometry aligns better with ground-truth labels. DistilBERT substantially outperforms sparse features on both metrics, confirming that its class structure is learnable even without a classifier}{figure.caption.11}{}}
